APP_NAME="School Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-school-domain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_school
DB_USERNAME=cpaneluser_school
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=minio

MAIL_MAILER=smtp
MAIL_HOST=mail.your-school-domain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-school-domain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-school-domain.com
MAIL_FROM_NAME="${APP_NAME}"
