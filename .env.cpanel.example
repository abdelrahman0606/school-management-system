## Shared cPanel hosting starter .env
##
## Copy this to `.env` on the server (not `.env.example`, which is tuned for
## the Docker dev stack — Redis, MinIO, `db`/`redis` service hostnames).
## Fill in the placeholders, then run `php artisan key:generate`.
##
## Full walkthrough: docs/cpanel-deployment.md

APP_NAME="School Management System"
APP_VERSION=1.3.2
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-school-domain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# cPanel MySQL is always local to the same host — DB_HOST=localhost, never a
# service name like the Docker .env.example uses. cPanel's "MySQL Databases"
# tool prefixes both the database name and username with your cPanel account
# username (e.g. cpaneluser_school), so DB_DATABASE/DB_USERNAME below will
# look longer than you typed.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_school
DB_USERNAME=cpaneluser_school
DB_PASSWORD=

# No Redis on shared hosting: the app already falls back to Laravel's
# database-backed session/cache/queue drivers (their tables ship in
# database/migrations already — cache, jobs, sessions all included), and
# every Cache::tags() call in the app goes through App\Support\CacheTags,
# which emulates tagging on ANY driver. Nothing behaves differently here
# than it does on Redis, other than raw speed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

# Object storage: leave this whole block commented out / unset. Every module
# calls Storage::disk('minio') by name, and config/filesystems.php makes that
# disk transparently fall back to local storage (storage/app/public, served
# through the storage:link symlink) whenever AWS_ENDPOINT is empty — which is
# exactly what happens by default here. Uncomment and fill these in only if
# you're pointing at a real S3-compatible provider (AWS S3, DigitalOcean
# Spaces, Backblaze B2, Cloudflare R2, a self-hosted MinIO, ...) instead of
# storing uploads on the hosting account's own disk.
FILESYSTEM_DISK=minio
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=true

# Mail — use the mailbox cPanel already created for this domain, or swap in
# a transactional provider (Resend, SMTP relay, ...). MAIL_MAILER=log (the
# Docker default) silently writes emails to storage/logs instead of sending
# them — do not ship that to production.
MAIL_MAILER=smtp
MAIL_HOST=mail.your-school-domain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-school-domain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-school-domain.com
MAIL_FROM_NAME="${APP_NAME}"
