APP_NAME="School Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=school_management_v2
DB_USERNAME=school_user
DB_PASSWORD=school_pass

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# MinIO — S3-compatible self-hosted file storage
FILESYSTEM_DISK=minio
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=school-files
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Email — Resend
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS=onboarding@resend.dev

# LMS AI checker — "anthropic" (default, needs a per-school API key entered
# in School Settings) or "self_hosted" (free/unlimited, needs the ai-detector
# Docker service running: docker compose up -d ai-detector). Only these two
# are implemented (see AiCheckerContract). If self_hosted, also set
# LMS_AI_SELF_HOSTED_SECRET to the same value on this app and ai-detector.
LMS_AI_PROVIDER=anthropic
LMS_AI_SELF_HOSTED_SECRET=
